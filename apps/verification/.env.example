# Copy to .env (never commit it) and fill in. Every secret is at least 32 characters, and the four keys below must all
# differ from each other.

# What the Keres server signs its calls to us with (== its AGE_VERIFICATION_SECRET).
AGE_VERIFICATION_SECRET=
# Only while rotating: the previous key, accepted until every Keres server has the new one. Then remove it.
# AGE_VERIFICATION_SECRET_PREVIOUS=

# What our event pushes are signed with (== its AGE_VERIFICATION_EVENTS_SECRET on the Keres side).
AGE_VERIFICATION_EVENTS_SECRET=

# The HMAC key of the identity commitment. Generate it once, keep it out of every database and backup. Changing it
# changes every commitment: the Keres server would then see every document as new.
COMMITMENT_KEY=

# Where the Keres server's events endpoint is. https unless it is loopback (or ALLOW_INSECURE=true).
KERES_EVENTS_URL=https://keres.me/api/age-verification/events

# Our own public address. The person's upload page is ${PUBLIC_URL}/v/<token>. https unless loopback.
PUBLIC_URL=https://verify.example.org

# Who we are, as the Keres server shows it. The id is kept with every verification: choose it once.
SERVICE_ID=keres-manual
DISPLAY_NAME=Keres manual verification

# Where the data and the keys live. Inside the container these are the two named volumes. KEY_DIR must not be inside
# DATA_DIR, and the two must differ: the service refuses to start otherwise.
# DATA_DIR=./data
# KEY_DIR=./keys

# A sending nobody decides within this many days is destroyed and reported as expired.
# SUBMISSION_TTL_DAYS=30

# The largest image accepted, in bytes (8 MiB by default). One image per document side and one live photo.
# MAX_UPLOAD_BYTES=8388608

# Plain http for non-loopback addresses. Only for a private test network; never for a public service.
# ALLOW_INSECURE=false

# Listen address and port. Loopback by default; the container image sets HOST=0.0.0.0 itself.
# HOST=127.0.0.1
# PORT=3102
