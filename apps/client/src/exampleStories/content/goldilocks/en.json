    },
    {
      "id": "01KYXBHD0K041CY3XA9T3X1BPX",
      "storyId": "01KYXBHD0K6DRY76ZD6ZWKKM1K",
      "name": "Baby Bear",
      "title": null,
      "gender": null,
      "race": "Bear",
      "subrace": null,
      "description": "The smallest of the three bears, owner of the small chair, soup, and bed.",
      "personality": "High-pitched and easily upset - the one who suffers the most from Goldilocks's visit.",
      "motivation": "Just wants his breakfast, his chair, and his bed left exactly as he left them.",
      "qualities": "The most sympathetic of the three - everything sized just for him is the one thing Goldilocks likes best, and ruins.",
      "weaknesses": "Too small to stop anything - his soup is eaten, his chair is broken, and his bed is slept in before he ever gets a say.",
      "biography": "The youngest of the bear family, whose porridge, chair, and bed turn out to be exactly Goldilocks's size.",
      "plannedTimeline": "Finds his chair broken and Goldilocks asleep in his own bed, the moment that finally wakes her and sends her fleeing.",
      "isFavorite": false,
      "extraNotes": null,
