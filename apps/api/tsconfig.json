{
  "compilerOptions": {
    // `@keres/shared` keeps the list of avatar icons in a .json file (see metadata/avatar.ts).
    "resolveJsonModule": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "strict": true,
    // A type import is written as one, and the compiler does not guess: what is written is what
    // is left in the bundle. Complements `@typescript-eslint/consistent-type-imports`, which
    // already asks for the same thing line by line.
    "verbatimModuleSyntax": true,
    // `noImplicitOverride` is left out for now: 52 inherited methods would need the modifier.
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@scripts/*": ["./scripts/*"],
      "@keres/shared": ["../../packages/shared/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
