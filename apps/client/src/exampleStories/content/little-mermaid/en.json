    },
    {
      "id": "01KYXBHD0MKXH274VYGG8CD6H4",
      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MESF281V4YSN4MAA5",
      "name": "The price of a soul",
      "index": 2,
      "summary": "Her grandmother tells her that only a human's love can grant a mermaid an immortal soul; desperate, she seeks out the Sea Witch, who trades her voice for a pair of human legs - every step will feel like walking on knives, and if the Prince ever marries another, she will turn to sea foam at dawn.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": false,
      "isStart": false,
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXBHD0M17B0T316JQAMJBEZ",
      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MPFV1BDE676KHZCBV",
      "name": "A silent companion",
      "index": 3,
      "summary": "Mute but graceful, she becomes the Prince's favorite companion at court; he is fond of her, but confesses his heart belongs to the girl he believes saved him from the wreck.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": false,
      "isStart": false,
      "isFavorite": false,
      "extraNotes": null,
