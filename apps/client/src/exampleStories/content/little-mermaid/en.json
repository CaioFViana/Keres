      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MPFV1BDE676KHZCBV",
      "name": "Her sisters' gift",
      "index": 5,
      "summary": "Her sisters surface with a magic knife, traded with the Witch for their own hair: if she kills the Prince before sunrise and lets his blood touch her feet, she will become a mermaid again; if not, she will perish.",
      "gap": null,
      "gapType": null,
      "duration": null,
