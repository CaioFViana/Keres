{
  "compilerOptions": {
    // `@keres/shared` keeps the avatar icon list in a .json (see metadata/avatar.ts).
    "resolveJsonModule": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    // A type import is written as such, and the compiler does not guess: what is written is what
    // remains in the bundle. Complements `@typescript-eslint/consistent-type-imports`, which already
    // enforces the same thing line by line.
    "verbatimModuleSyntax": true,
    // Compiler locks enabled because today they cost zero errors (measured) and bar whole
    // classes of carelessness: forgotten variable/import, `case` falling through to the next, and
    // a method overriding the base class's without saying so.
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
