{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "--prefix",
        "apps/client"
      ],
      "port": 8081
    },
    {
      "name": "showcase",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:showcase",
        "--prefix",
        "apps/admin"
      ],
      "port": 5174
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/admin"
      ],
      "port": 5173
    },
    {
      "name": "site",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "apps/site",
        "dev"
      ],
      "port": 5175
    }
  ]
}
