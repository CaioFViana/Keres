      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "The Merchant",
      "title": "Beauty's father",
      "gender": "Male",
      "race": "Human",
      "subrace": null,
      "description": "A merchant who lost his fortune at sea and loses his way in the forest on his way home.",
      "personality": "Loving and honorable, quick to blame himself for the danger he brings on his daughter.",
      "motivation": "Wants only to provide for his children and keep his word, even at the cost of his own life.",
      "qualities": "Devoted and honest, willing to return to the Beast's castle to face his punishment himself.",
      "weaknesses": "His once-great fortune, lost when his trading ships were feared sunk at sea, left the family unable to protect themselves from misfortune.",
      "biography": "A once-wealthy merchant whose ships were lost at sea, reduced to a modest country life until a detour through an enchanted forest changes his family's fate again.",
      "plannedTimeline": "Is spared by the Beast and reunited with Beauty after the curse breaks.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
