  "scenes": [
    {
      "id": "01KYXBHD0M83N1C3AX7JH04JD2",
      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MK3Q3KZ5X4XFDSBY8",
      "name": "O mundo acima das ondas",
      "index": 0,
      "summary": "Ao completar quinze anos, a pequena sereia sobe à superfície pela primeira vez e se encanta, à distância, por um príncipe que celebra seu aniversário a bordo de um navio.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": false,
      "isStart": true,
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXBHD0MQP5BEK9PFDBE3580",
      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MK3Q3KZ5X4XFDSBY8",
      "name": "Um resgate em silêncio",
      "index": 1,
      "summary": "Uma tempestade afunda o navio; a pequena sereia salva o Príncipe da morte e o deixa à beira de um templo, observando escondida quando uma jovem o encontra ali - e ele nunca saberá quem de fato o salvou.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": false,
      "isStart": false,
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
