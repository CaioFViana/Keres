{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./*"],
      "@expo/vector-icons": ["./src/icons/vectorIcons.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
