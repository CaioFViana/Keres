DATABASE_URL="postgresql://user:password@localhost:5432/keres_db"
JWT_SECRET="supersecretjwtkeythatis32characterslongatleast"
JWT_SECRET_REFRESH="supersecretjwtkeythatis32charactersrefreshing"
ROOT_ADMIN_USERNAME="root"
ROOT_ADMIN_PASSWORD="changeme12345"

# Gallery media storage. Keep this backend and path unchanged while this database contains
# media; switching to S3 requires an explicit migration or a fresh database/storage.
MEDIA_STORAGE_DRIVER="local"
MEDIA_STORAGE_PATH="./media-storage"
MEDIA_MAX_BYTES="52428800"

# S3-compatible gallery storage (uncomment and set all values only for a new/migrated DB).
# MEDIA_STORAGE_DRIVER="s3"
# MEDIA_S3_ENDPOINT="http://localhost:8333"
# MEDIA_S3_REGION="us-east-1"
# MEDIA_S3_BUCKET="my-bucket"
# MEDIA_S3_ACCESS_KEY_ID="admin"
# MEDIA_S3_SECRET_ACCESS_KEY="replace-with-a-secret"
# MEDIA_S3_PREFIX="keres"
# MEDIA_S3_FORCE_PATH_STYLE="true"

# Payments, TEST VALUES ONLY (made up; this file is committed, so never put real keys here).
# Pair with apps/payments/.env; check the pair with: bun run payments:env-check
PAYMENT_CONNECTOR_URL="http://127.0.0.1:3101"
PAYMENT_CONNECTOR_SECRET="dev-keres-to-connector-0123456789-abcdefghij-A1"
PAYMENT_EVENTS_SECRET="dev-connector-to-keres-0123456789-abcdefghij-B2"
PAYMENT_PLAY_ENDPOINT_SECRET="dev-play-endpoint-0123456789-abcdefghijklmn-C3"
# The fake bank page is plain http on this machine; a real provider page must be https.
PAYMENT_ALLOW_INSECURE_REDIRECTS="true"
