  "locations": [
    {
      "id": "01KYXBHD0FT43JJV1HABMERBPA",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "A Casa do Mercador",
      "description": "A casa modesta onde Bela vive com o pai e as irmãs desde que a fortuna da família se perdeu.",
      "climate": "Rural e simples, bem longe da vida urbana que a família já conheceu.",
      "culture": "Uma casa humilde onde o trabalho duro substituiu os confortos da riqueza.",
      "politics": "Nenhuma autoridade além da liderança tranquila do próprio Mercador sobre sua casa.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
