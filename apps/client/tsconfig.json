{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // `@keres/shared` guarda a lista de ícones de avatar num .json (ver metadata/avatar.ts).
    "resolveJsonModule": true,
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
