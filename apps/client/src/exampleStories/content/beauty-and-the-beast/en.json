    {
      "id": "01KYXBHD0FXNK8WNHEXYJ6K4SH",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "The Fairy",
      "title": null,
      "gender": "Female",
      "race": "Fairy",
      "subrace": null,
      "description": "The fairy who cast the curse upon the prince, watching in secret to see whether Beauty and the Beast will learn to love one another.",
      "personality": "Just but unforgiving of cruelty, testing character before granting mercy.",
      "motivation": "Wants the prince to learn true kindness before allowing the curse to be lifted.",
      "qualities": "Powerful and patient, willing to wait years to see whether her lesson takes hold.",
      "weaknesses": "Her judgment can be severe - she is prepared to punish Beauty's sisters as harshly as she once punished the prince.",
      "biography": "A fairy who, disguised as a beggar, was refused shelter by a spoiled young prince and cursed him into a beast until he could learn to love and be loved for who he truly is.",
      "plannedTimeline": "Reveals herself once the curse breaks, and decides the sisters' fate depending on the version of the ending.",
