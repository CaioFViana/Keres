{
  "compilerOptions": {
    "target": "ES2022",
    // `verbatimModuleSyntax` does not apply here: Electron's main process is CommonJS, and the
    // flag forbids ES module syntax in a CJS file. The linter covers the same discipline.
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist-electron",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
