  "locations": [
    {
      "id": "01KYXBHD0FT43JJV1HABMERBPA",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "The Merchant's House",
      "description": "The modest house where Beauty lives with her father and sisters since the family fortune was lost.",
      "climate": "Rural and plain, a world away from the city life the family once knew.",
      "culture": "A humbled household where hard work has replaced the comforts of wealth.",
      "politics": "No authority beyond the Merchant's own quiet leadership of his household.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
