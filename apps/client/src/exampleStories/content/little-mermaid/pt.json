      "deletedAt": null
    },
    {
      "id": "01KYXBHD0M17B0T316JQAMJBEZ",
      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MPFV1BDE676KHZCBV",
      "name": "Uma companhia muda",
      "index": 3,
      "summary": "Muda, mas graciosa, ela se torna a companhia favorita do Príncipe na corte; ele a trata com carinho, mas confessa que seu coração pertence à jovem que acredita tê-lo salvo do naufrágio.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": false,
      "isStart": false,
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXBHD0MX4ZRJ6V6EE57QCXG",
      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MPFV1BDE676KHZCBV",
      "name": "Um casamento real",
      "index": 4,
      "summary": "O Príncipe se casa com uma princesa vizinha - que é, de fato, a jovem do templo; de coração partido, a pequena sereia assiste à cerimônia no convés do navio, sabendo o que o amanhecer trará.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": false,
      "isStart": false,
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXBHD0MYMJ2B760NNHVCP90",
      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MPFV1BDE676KHZCBV",
      "name": "O presente das irmãs",
      "index": 5,
      "summary": "Suas irmãs emergem do mar com uma faca mágica, trocada por seus próprios cabelos com a Bruxa: se ela matar o Príncipe antes do sol nascer e deixar o sangue tocar seus pés, voltará a ser sereia; se não, perecerá.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": false,
      "isStart": false,
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXBHD0MQG0B9N41TXGDA4V3",
      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MPFV1BDE676KHZCBV",
      "name": "Filha do ar",
      "index": 6,
      "summary": "Incapaz de ferir quem ama, a pequena sereia lança a faca e a si mesma ao mar ao amanhecer - mas em vez de virar espuma, ergue-se entre as filhas do ar, espíritos que podem conquistar uma alma imortal após trezentos anos de boas ações.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": true,
