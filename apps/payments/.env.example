# Copy to .env (never commit it) and fill in. Every secret is at least 32 characters.
# The connector key and the events key must differ; the previous-key variables exist only
# while rotating a key, then are removed.

# What the Keres server signs its /v1/* calls with (== its PAYMENT_CONNECTOR_SECRET).
KERES_CONNECTOR_SECRET=
# KERES_CONNECTOR_SECRET_PREVIOUS=

# Where the Keres server is, and what our event pushes are signed with
# (== its PAYMENT_EVENTS_SECRET, different from the connector key).
KERES_BASE_URL=https://keres.me
KERES_EVENTS_SECRET=
# KERES_EVENTS_SECRET_PREVIOUS=

# Our own public address (PayPal/Stripe return pages and webhooks point here).
PUBLIC_BASE_URL=https://buy.keres.me

# PayPal (absent: the paypal method is not listed).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_WEBHOOK_ID=

# Stripe, behind the googlepay method (absent: the method is not listed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mock provider for physical end-to-end tests (no PSP, no real money). Only registers
# when true AND PUBLIC_BASE_URL is loopback; anywhere else it silently stays off.
# MOCK_METHODS=true

# Google Play Billing verification for the mobile app (absent: /v1/play/verify is off).
# Mock is opt-in and off by default: PLAY_MOCK=true accepts any purchase token -
# homologation only, never production.
PLAY_ENDPOINT_SECRET=
# Secret in the Pub/Sub push address for Google's renewal and cancel notifications (see README).
# PLAY_NOTIFICATION_SECRET=
#PLAY_MOCK=true
# The whole key file on ONE line, in single quotes (its private_key contains \n sequences):
# PLAY_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
PLAY_SERVICE_ACCOUNT_JSON=
# Listen address. Loopback by default (the proxy is the only thing that should reach it); the
# container image sets 0.0.0.0 itself.
# HOST=127.0.0.1

# The Keres server side needs, in its own .env:
#   PAYMENT_CONNECTOR_URL=https://buy.keres.me
#   PAYMENT_CONNECTOR_SECRET=<same as KERES_CONNECTOR_SECRET above>
#   PAYMENT_EVENTS_SECRET=<same as KERES_EVENTS_SECRET above>
