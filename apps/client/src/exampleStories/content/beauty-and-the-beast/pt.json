  "characters": [
    {
      "id": "01KYXBHD0FC1Q4CNJK79XCNMVW",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "Bela",
      "title": null,
      "gender": "Feminino",
      "race": "Humana",
      "subrace": null,
      "description": "A mais nova e mais gentil das filhas de um mercador, leitora ávida e de coração generoso.",
      "personality": "Gentil, atenciosa e incapaz de ser cruel, mesmo com quem a maltrata.",
      "motivation": "Quer poupar a vida do pai e, mais tarde, ser honesta com o próprio coração sobre a Fera.",
      "qualities": "Leal, generosa e capaz de enxergar além das aparências.",
      "weaknesses": "Tão devotada aos outros que quase deixa a Fera morrer de tristeza antes de admitir os próprios sentimentos.",
      "biography": "A filha mais nova do mercador, diferente das irmãs vaidosas em temperamento, que oferece a própria liberdade para salvar o pai da fúria da Fera.",
      "plannedTimeline": "Volta ao castelo a tempo, confessa seu amor e quebra a maldição - casando-se com o príncipe que a Fera um dia foi.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
