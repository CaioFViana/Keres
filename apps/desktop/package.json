{
  "name": "@keres/desktop",
  "desktopName": "com.keres.desktop.desktop",
  "version": "1.7.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "prestart": "bun run --cwd ../client build",
    "start": "bun run build:main && electron .",
    "prebuild": "bun run --cwd ../client build",
    "build": "bun run build:main",
    "build:main": "tsc -p tsconfig.json",
    "prepackage": "bun run build",
    "package": "electron-builder",
    "package:win": "bun run build && electron-builder --win",
    "package:mac": "bun run build && electron-builder --mac",
    "package:linux": "bun run build && electron-builder --linux",
    "capture:screens": "bun scripts/capture-screens.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint src test vitest.config.ts --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:sqlite-web": "bun test/run-sqlite-web-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.6",
    "eslint": "^9.25.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10"
  }
}
