{
  "compilerOptions": {
    "target": "ES2022",
    // `verbatimModuleSyntax` não se aplica aqui: o processo principal do Electron é CommonJS,
    // e a flag proíbe sintaxe de módulo ES num arquivo CJS. O ESLint cobre a mesma disciplina.
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist-electron",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
