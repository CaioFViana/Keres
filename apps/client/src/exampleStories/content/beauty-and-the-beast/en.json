  "worldRules": [
    {
      "id": "01KYXBHD0F4BB8WS98MC1Z1Y6P",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "title": "A Promise of Return",
      "description": "The Beast can only be freed if he is loved of his own free will. When he allows Beauty to visit her family, he warns her: if she does not return within the promised time, he will die of sorrow.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXK9BMQARJ9BEMR2NXV5CRT",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "title": "The Beast's Enchanted Gifts",
      "description": "Two enchanted objects let Beauty stay connected to both worlds: a ring that carries her instantly between her family's house and the Beast's castle, and a mirror that lets her see either place from afar whenever she wishes.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
