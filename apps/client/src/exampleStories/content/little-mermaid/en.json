    },
    {
      "id": "scene-11",
      "storyId": "STORYLITTLEMERMAID00000000",
      "chapterId": "chapter-1",
      "locationId": "location-4",
      "name": "Daughter of the air",
      "index": 6,
      "summary": "Unable to harm the man she loves, the little mermaid casts the knife and herself into the sea at dawn - but instead of turning to foam, she rises among the daughters of the air, spirits who may earn an immortal soul after three hundred years of good deeds.",
