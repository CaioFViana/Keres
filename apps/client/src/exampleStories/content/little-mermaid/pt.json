      "deletedAt": null
    },
    {
      "id": "01KYXBHD0MKXH274VYGG8CD6H4",
      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MESF281V4YSN4MAA5",
      "name": "O preço da alma",
      "index": 2,
      "summary": "Sua avó lhe conta que só o amor de um humano pode dar a uma sereia uma alma imortal; desesperada, ela procura a Bruxa do Mar, que troca sua voz por um par de pernas humanas - cada passo doerá como lâminas, e se o Príncipe se casar com outra, ela se desfará em espuma do mar ao amanhecer.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": false,
      "isStart": false,
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
