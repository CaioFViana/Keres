{
  "name": "@keres/api",
  "version": "1.7.0",
  "main": "index.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "start:launcher": "bun run src/launcher.ts",
    "prebuild": "bun run --cwd ../admin build && bun run --cwd ../client build",
    "build": "bun scripts/package-server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test vitest.config.ts vitest.integration.config.ts --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:sqlite": "vitest run --config vitest.integration.sqlite.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "db:generate": "bun drizzle-kit generate --dialect postgresql --schema=./src/db/schema.ts",
    "db:generate:sqlite": "bun drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:migrate": "bun drizzle-kit migrate",
    "db:studio": "bun drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@keres/shared": "workspace:*",
    "@libsql/client": "^0.17.4",
    "@sinclair/typebox": "^0.34.41",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.16",
    "pg": "^8.12.0",
    "ulid": "^3.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.1.6",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.25.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10"
  }
}
