    },
    {
      "id": "01KYXK9BMQARJ9BEMR2NXV5CRT",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "title": "Os Presentes Encantados da Fera",
      "description": "Dois objetos encantados mantêm Bela ligada aos dois mundos: um anel que a transporta instantaneamente entre a casa de sua família e o castelo da Fera, e um espelho que mostra qualquer um dos dois lugares à distância sempre que ela desejar.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
