      "characters": [
        {
          "id": "KRS3ACTPTCR001000000000000",
          "storyId": "KRS3ACTPTP0000000000000000",
          "name": "Protagonista",
          "description": "O herói da história. Dê a ele um nome, um desejo e uma ferida — e deixe os três atos testarem tudo isso.",
          "motivation": "O que ele mais quer. Por baixo, esconda o que ele realmente precisa: a distância entre os dois é o arco.",
          "createdAt": "2026-01-01T00:00:00.000Z",
          "updatedAt": "2026-01-01T00:00:00.000Z",
          "version": 1,
          "isDeleted": false,
          "deletedAt": null
        },
        {
          "id": "KRS3ACTPTCR002000000000000",
          "storyId": "KRS3ACTPTP0000000000000000",
          "name": "Antagonista",
          "description": "A sombra que se opõe ao herói. Os melhores vilões acreditam que estão certos — dê um motivo ao seu.",
          "motivation": "O que ele quer, e por que não pode deixar o herói conseguir.",
          "createdAt": "2026-01-01T00:00:00.000Z",
          "updatedAt": "2026-01-01T00:00:00.000Z",
          "version": 1,
          "isDeleted": false,
          "deletedAt": null
        }
      ],
