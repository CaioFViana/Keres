{
  // The scripts here (screen capture, the web SQLite smoke test) run with `bun`, as ESM - unlike
  // Electron's main process, which is CommonJS and therefore has a separate tsconfig. Without
  // this file they would be the only part of the desktop app with no type checking.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "noEmit": true,
    "types": ["bun", "node"]
  },
  "include": ["scripts", "test/run-sqlite-web-smoke.ts"]
}
