      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MK3Q3KZ5X4XFDSBY8",
      "name": "A rescue in silence",
      "index": 1,
      "summary": "A storm sinks the ship; the little mermaid saves the Prince from drowning and leaves him by a temple, watching in hiding as a young woman finds him there - he will never know who truly saved him.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
