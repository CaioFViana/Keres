{
  "name": "@keres/client",
  "main": "./index.js",
  "version": "1.10.3",
  "license": "MPL-2.0",
  "scripts": {
    "prestart": "bun scripts/generate-indexes.ts",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "bun scripts/generate-indexes.ts",
    "build": "expo export -p web && bun scripts/inject-web-preloads.ts dist",
    "build:hosted": "bun scripts/generate-indexes.ts && EXPO_PUBLIC_HOSTED=1 KERES_WEB_BASE_URL=/client expo export -p web --output-dir dist-hosted && bun scripts/inject-web-preloads.ts dist-hosted",
    "build:pages": "bun scripts/generate-indexes.ts && EXPO_PUBLIC_SERVERLESS=1 expo export -p web --output-dir dist-pages && bun scripts/inject-web-preloads.ts dist-pages",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "expo lint src test scripts plugins --no-cache -- --max-warnings 0",
    "test": "jest --maxWorkers=2 --workerIdleMemoryLimit=512MB",
    "test:coverage": "jest --maxWorkers=2 --workerIdleMemoryLimit=512MB --coverage",
    "test:coverage:ci": "jest --ci --coverage",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "example-story:build": "bun scripts/build-example-story.ts",
    "shipped-packs:build": "bun scripts/build-shipped-packs.ts",
    "capture:setup": "bun scripts/generate-indexes.js && expo export -p web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@keres/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.18.8",
    "@shopify/react-native-skia": "2.14.0",
    "axios": "^1.13.2",
    "canvaskit-wasm": "0.41.0",
    "drizzle-orm": "^0.44.7",
    "expo": "^58.0.0",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-clipboard": "~58.0.4",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-iap": "^5.8.2",
    "expo-image": "~58.0.16",
    "expo-image-manipulator": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-navigation-bar": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "i18next": "^25.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^16.2.4",
    "react-native": "0.88.0",
    "react-native-enriched-html": "1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "spark-md5": "^3.0.2",
    "ulid": "^3.0.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@react-native/virtualized-lists": "0.88.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "30.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.3.0",
    "@types/spark-md5": "^3.0.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-expo": "~58.0.12",
    "pngjs": "^7.0.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
