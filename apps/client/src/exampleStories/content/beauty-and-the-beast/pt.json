    },
    {
      "id": "01KYXBHD0FZ2NWDRHTAD2KY6YF",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "Castelo da Fera",
      "description": "Um castelo encantado onde todo desejo de Bela é atendido, exceto o de ver seu rosto verdadeiro.",
      "climate": "Grandioso e aquecido por dentro, cuidado por criados encantados que nunca se veem.",
      "culture": "Uma corte solitária de um só, onde todo conforto é oferecido e toda refeição é dividida apenas com a Fera.",
      "politics": "Governado inteiramente pela Fera, embora o próprio encantamento não responda a ninguém além da Fada.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
