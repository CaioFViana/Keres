    },
    {
      "id": "01KYXBHD0MX4ZRJ6V6EE57QCXG",
      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MPFV1BDE676KHZCBV",
      "name": "A royal wedding",
      "index": 4,
      "summary": "The Prince marries a neighboring princess - who is, in truth, the girl from the temple; heartbroken, the little mermaid watches the ceremony aboard the ship, knowing what the dawn will bring.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": false,
      "isStart": false,
      "isFavorite": false,
