    },
    {
      "id": "01KYXBHD0FE9MY6A6A9B1GT176",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "The Beast",
      "title": "Cursed prince",
      "gender": "Male",
      "race": "Human",
      "subrace": "Enchanted beast",
      "description": "A prince turned into a beast by a fairy, doomed to remain so until he is loved for who he truly is.",
      "personality": "Fearsome in appearance but courteous and melancholy underneath, aware of how frightening he seems.",
      "motivation": "Hopes, without much confidence, that Beauty could one day love him despite his form.",
      "qualities": "Patient, generous, and consistently gentle with Beauty despite his monstrous looks.",
      "weaknesses": "So convinced of his own unlovability that he nearly wastes away from grief when Beauty stays away.",
      "biography": "A prince who, as a spoiled and unkind boy, refused shelter to a fairy in disguise and was cursed to wear a beast's form until he is loved for who he truly is.",
      "plannedTimeline": "Nearly dies of grief waiting for Beauty's return, then is restored to his human form once she confesses her love.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
