{
  "name": "@keres/api",
  "version": "1.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test vitest.config.ts --ext .ts",
    "test": "vitest run",
    "build": "cd ../admin && bun run build",
    "db:generate": "bun drizzle-kit generate --dialect postgresql --schema=./src/db/schema.ts",
    "db:migrate": "bun drizzle-kit migrate",
    "db:push": "bun drizzle-kit push --schema=./src/db/schema.ts",
    "db:drop": "bun drizzle-kit drop",
    "db:studio": "bun drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@elysiajs/bearer": "^1.4.1",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.11",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@keres/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.11.6",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.16",
    "pg": "^8.12.0",
    "ulid": "^3.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.1.6",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.25.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  }
}
