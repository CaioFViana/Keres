      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "A Segunda Irmã",
      "title": null,
      "gender": "Feminino",
      "race": "Humana",
      "subrace": null,
      "description": "A outra irmã de Bela, tão orgulhosa e ciumenta quanto a mais velha.",
      "personality": "Vaidosa e fácil de magoar em seu orgulho, sempre seguindo a irmã mais velha.",
      "motivation": "Compartilha a esperança da irmã de que atrasar Bela lhe traga desgraça.",
      "qualities": "Charmosa o bastante em sociedade para esconder sua inveja dos outros.",
      "weaknesses": "Se importa mais com aparências e status do que com a felicidade da irmã.",
      "biography": "A segunda das irmãs mais velhas de Bela, tão incapaz quanto a mais velha de aceitar a vida mais modesta da família.",
      "plannedTimeline": "Compartilha o destino humilhado da irmã quando a maldição se quebra, poupada apenas pela bondade de Bela.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXBHD0FXNK8WNHEXYJ6K4SH",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "A Fada",
      "title": null,
      "gender": "Feminino",
      "race": "Fada",
      "subrace": null,
      "description": "A fada que lançou a maldição sobre o príncipe, e que observa em segredo se Bela e a Fera aprenderão a se amar.",
      "personality": "Justa mas implacável com a crueldade, testando o caráter antes de conceder perdão.",
      "motivation": "Quer que o príncipe aprenda a verdadeira bondade antes de permitir que a maldição se quebre.",
      "qualities": "Poderosa e paciente, disposta a esperar anos para ver se sua lição foi aprendida.",
      "weaknesses": "Seu julgamento pode ser severo - está disposta a punir as irmãs de Bela tão duramente quanto puniu o príncipe.",
      "biography": "Uma fada que, disfarçada de mendiga, foi recusada por um príncipe jovem e mimado e o amaldiçoou a viver como fera até aprender a amar e ser amado por quem realmente é.",
      "plannedTimeline": "Revela-se quando a maldição se quebra, e decide o destino das irmãs conforme a versão do final.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    }
