    },
    {
      "id": "01KYXBHD0FKEFPV8HHMXJJBST2",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "Jardim Encantado",
      "description": "O jardim e a fonte onde a Fera busca consolo em sua solidão.",
      "climate": "Florido e viçoso o ano todo, cuidado pela mesma magia invisível do castelo.",
      "culture": "Um refúgio silencioso, o único lugar onde a Fera se permite ser visto mais vulnerável.",
      "politics": null,
      "isFavorite": false,
      "extraNotes": null,
