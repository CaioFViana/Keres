node_modules
bun.lockb

# Build output do painel admin (apps/admin) - gerado por `bun run build`, servido pela API
# em runtime (ver apps/api/src/index.ts). Não é código-fonte.
apps/admin/dist

# Arquivos de mídia da galeria, gravados em disco pelo servidor e endereçados por hash.
# São conteúdo de usuário, não código - o caminho é configurável por MEDIA_STORAGE_PATH.
apps/api/media-storage/

# Build output do client web (apps/client) - gerado por `bun run export:web`, consumido
# pelo Electron (ver apps/desktop). Não é código-fonte.
apps/client/dist

# Build output do Electron (apps/desktop) - main/preload compilados e instaladores gerados.
apps/desktop/dist-electron
apps/desktop/release
