{
  "name": "@keres/client",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "scripts": {
    "prestart": "node scripts/generate-migrations-index.js && node scripts/generate-example-stories-index.js",
    "example-stories:generate": "node scripts/generate-example-stories-index.js",
    "start": "expo start",
    "start-clear": "expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "node scripts/generate-migrations-index.js && node scripts/generate-example-stories-index.js && expo export -p web",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "locales:audit": "tsx scripts/verify-translations.ts",
    "locales:audit:force": "tsx scripts/verify-translations.ts --force"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/portal": "^1.0.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "axios": "^1.13.2",
    "drizzle-orm": "^0.44.7",
    "expo": "~54.0.32",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-doctor": "^1.17.12",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.22",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.9",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.9",
    "i18next": "^25.6.0",
    "jszip": "^3.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.2.4",
    "react-native": "0.81.5",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-portalize": "^1.0.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "spark-md5": "^3.0.2",
    "ulid": "^3.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/spark-md5": "^3.0.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "tsx": "^4.16.2",
    "typescript": "~5.9.2"
  },
  "private": true
