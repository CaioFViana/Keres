  "notes": [
    {
      "id": "01KYXK9BMQQ3YTD5NZM6ND2TPQ",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "title": "Por Que o Príncipe Foi Amaldiçoado",
      "body": "Ainda menino, o príncipe era mimado e cruel apesar da riqueza da família. Quando uma velha mendiga pediu abrigo numa noite de tempestade, ele a expulsou com desdém - e ela se revelou uma fada poderosa, amaldiçoando-o a viver como fera até aprender a amar, e ser amado, pelo que existe por dentro e não pela aparência.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXK9BMQABY0HYX1Y9VVMXBQ",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "title": "Os Navios Perdidos",
      "body": "O Mercador um dia comandou uma frota de navios de comércio. Quando foram dados como perdidos numa tempestade no mar, sua fortuna desapareceu junto com eles, forçando a família a deixar a cidade por uma casa modesta no campo - a mesma viagem, feita para checar um último navio sobrevivente, que o leva ao castelo da Fera.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
