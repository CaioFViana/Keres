  "characters": [
    {
      "id": "01KYXBHD0JHTF79MKSRY0RB0N7",
      "storyId": "01KYXBHD0JW7A6HKZ9XA71RDWQ",
      "name": "Cinderella",
      "title": null,
      "gender": "Female",
      "race": "Human",
      "subrace": null,
      "description": "A kind and hard-working young woman, treated as a servant in her own home.",
      "personality": "Patient and good-natured despite years of mistreatment, never bitter toward her stepfamily.",
      "motivation": "Wishes, quietly and without much hope, for a single night of joy at the royal ball.",
      "qualities": "Graceful, hardworking, and kind even to the mice and small creatures around the house.",
      "weaknesses": "So used to obeying that she nearly gives up on the ball entirely until the Fairy Godmother intervenes.",
      "biography": "Once a beloved daughter, reduced to a servant in her own home after her father remarried a cold widow with two daughters of her own.",
      "plannedTimeline": "Marries the Prince once the glass slipper proves her identity, and by some tellings, forgives her stepfamily.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXBHD0J895XZFCMMV9X03V5",
      "storyId": "01KYXBHD0JW7A6HKZ9XA71RDWQ",
      "name": "Stepmother",
      "title": null,
      "gender": "Female",
      "race": "Human",
      "subrace": null,
      "description": "A cold, calculating widow who openly favors her own daughters.",
      "personality": "Proud, controlling, and openly dismissive of Cinderella.",
      "motivation": "Wants only her own daughters to marry well, and sees Cinderella as competition to be kept down.",
      "qualities": "Sharp and strategic in running the household to her daughters' advantage.",
      "weaknesses": "Her favoritism is so blatant that it fools no one outside the family, least of all the reader.",
      "biography": "A widow who remarried Cinderella's father and, after his death, ruled the household entirely for her own daughters' benefit.",
      "plannedTimeline": "Left humiliated once the glass slipper reveals Cinderella's identity before the whole court.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXBHD0JRER5VNKDJB326PKK",
      "storyId": "01KYXBHD0JW7A6HKZ9XA71RDWQ",
      "name": "The Elder Stepsister",
      "title": null,
      "gender": "Female",
      "race": "Human",
      "subrace": null,
      "description": "One of Cinderella's stepsisters, vain and clumsy.",
      "personality": "Vain and quick-tempered, easily jealous of anyone prettier.",
      "motivation": "Desperate to catch the Prince's eye at the ball, whatever the cost to Cinderella.",
      "qualities": "Confident enough to try on the glass slipper herself without a shred of doubt.",
      "weaknesses": "Her vanity blinds her to how unkind she is, right up to the moment the slipper simply will not fit.",
      "biography": "The elder of Cinderella's two stepsisters, raised to believe her own comfort matters more than anyone else's.",
      "plannedTimeline": "Fails to fit the glass slipper, exposing the family's cruelty before the whole court.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
