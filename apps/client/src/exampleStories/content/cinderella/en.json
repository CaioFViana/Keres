      "storyId": "01KYXBHD0JW7A6HKZ9XA71RDWQ",
      "name": "Prince",
      "title": "Heir to the throne",
      "gender": "Male",
      "race": "Human",
      "subrace": null,
      "description": "The kingdom's heir, tasked with choosing a bride at the royal ball.",
      "personality": "Attentive and sincere, taken with Cinderella's company rather than just her appearance.",
      "motivation": "Wants to find the mysterious young woman who fled the ball, not just any bride.",
      "qualities": "Persistent - determined to search the whole kingdom with the glass slipper until he finds her.",
      "weaknesses": "Never even learns Cinderella's name at the ball, and nearly loses her for good when she flees.",
      "biography": "The kingdom's heir, who dances all night with an unknown guest at his own ball and cannot forget her afterward.",
