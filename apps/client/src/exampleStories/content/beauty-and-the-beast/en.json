    }
  ],
  "notes": [
    {
      "id": "01KYXK9BMQQ3YTD5NZM6ND2TPQ",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "title": "Why the Prince Was Cursed",
      "body": "As a boy, the prince was spoiled and unkind despite his family's wealth. When an old beggar woman asked for shelter one stormy night, he turned her away in scorn - and she revealed herself as a powerful fairy, cursing him to wear a beast's form until he could learn to love, and be loved, for what lies within rather than his appearance.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXK9BMQABY0HYX1Y9VVMXBQ",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "title": "The Lost Ships",
      "body": "The Merchant once commanded a fleet of trading ships. When they were feared lost in a storm at sea, his fortune vanished with them, forcing the family to leave the city for a modest country house - the very journey, made to check on one last surviving ship, that leads him to the Beast's castle.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    }
