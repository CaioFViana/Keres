    },
    {
      "id": "01KYXBHD0JA1MR77MHPJ7R4KNS",
      "storyId": "01KYXBHD0JW7A6HKZ9XA71RDWQ",
      "name": "The Younger Stepsister",
      "title": null,
      "gender": "Female",
      "race": "Human",
      "subrace": null,
      "description": "The other stepsister, just as vain as the elder.",
      "personality": "Vain in her own right, though slightly less cruel than her elder sister.",
      "motivation": "Follows her sister and mother's lead in hoping to marry above her station.",
      "qualities": "Sociable enough to be tolerated at court, if not admired.",
      "weaknesses": "Never questions the family's treatment of Cinderella, even when it plainly troubles her conscience.",
      "biography": "The younger of Cinderella's two stepsisters, shaped by the same household that favored her over her stepsister.",
      "plannedTimeline": "Also fails to fit the glass slipper, sharing in her family's public humiliation.",
      "isFavorite": false,
      "extraNotes": null,
