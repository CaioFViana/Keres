      "id": "scene-5",
      "storyId": "STORYLITTLEMERMAID00000000",
      "chapterId": "chapter-1",
      "locationId": "location-2",
      "name": "The world above the waves",
      "index": 0,
      "summary": "On turning fifteen, the little mermaid rises to the surface for the first time and falls, from afar, for a prince celebrating his birthday aboard a ship.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
