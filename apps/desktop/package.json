{
  "name": "@keres/desktop",
  "desktopName": "com.keres.desktop.desktop",
  "version": "1.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build:client": "cd ../client && bun run export:web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "build:main": "tsc -p tsconfig.json",
    "build": "bun run build:client && bun run build:main",
    "start": "bun run build && electron .",
    "package": "bun run build && electron-builder",
    "package:win": "bun run build && electron-builder --win",
    "package:mac": "bun run build && electron-builder --mac",
    "package:linux": "bun run build && electron-builder --linux"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@types/node": "^22.10.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.6",
    "eslint": "^9.25.0",
    "typescript": "^5.5.3"
  }
}
