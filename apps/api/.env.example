# Database and authentication
#
# Two engines are supported. "postgres" (the default) talks to a Postgres server. "sqlite"
# keeps everything in a single local file, so the API runs without a database server at all -
# a good fit for a small, self-hosted instance.
#
# Do not switch driver on an instance that already has data: the two store the same schema in
# different files, and nothing is copied between them. Pick one before the first boot, or
# migrate the data yourself.
DATABASE_DRIVER="postgres"
DATABASE_URL="postgresql://user:password@localhost:5432/keres_db"

# With DATABASE_DRIVER="sqlite", DATABASE_URL is the file instead:
# DATABASE_DRIVER="sqlite"
# DATABASE_URL="file:./keres.db"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_SECRET_REFRESH="replace-with-another-random-secret-of-at-least-32-characters"
PORT="3000"
NODE_ENV="development"

# How long a stopping server lets running requests finish, in milliseconds (default 7000). `docker stop`
# waits 10 s before killing: raise `stop_grace_period` together with this.
# SHUTDOWN_GRACE_MS="7000"

# Sell plans through the payments microservice (see docs/payment_connectors.md): without it the server
# sells nothing and nothing about payments is shown. Secrets are at least 32 characters each, and the
# connector key and the events key must differ. To try it all on one machine: bun run payments:local.
# PAYMENT_CONNECTOR_URL="https://buy.keres.me"
# PAYMENT_CONNECTOR_SECRET="replace-with-the-services-KERES_CONNECTOR_SECRET"
# What the service signs its event pushes with (== its KERES_EVENTS_SECRET):
# PAYMENT_EVENTS_SECRET="replace-with-the-services-KERES_EVENTS_SECRET"
# The Bearer [REDACTED] the payments service asks for at POST /v1/play/verify (== its PLAY_ENDPOINT_SECRET):
# only the server holds it, so the app can relay in-app purchases without ever seeing it.
# PAYMENT_PLAY_ENDPOINT_SECRET=""

# Release the payment records of a closed account this many days after it was closed (at least 30;
# default 1825, five years): its subscription, attempts and store claims are deleted and the ledger
# keeps its lines without the person. See docs/payment_connectors.md.
# PAYMENT_RETENTION_DAYS="1825"

# Age verification (docs/age_verification.md). Accounts on this server are for people 18 or older.
# `manual` (default when unset): no verification service; accounts start active and unverified, and an administrator
#   marks verified accounts by hand (admin Users page). The adults-only area exists and `allowNsfw` can be turned on.
#   (`disabled` is still accepted and read as `manual`.)
# `required`: boot refuses to start without AGE_VERIFICATION_URL and both secrets; a new account waits, pending, for the
#   service's approval, and new registrations are refused ("unavailable") while the service is away.
# The service is run separately (not by Keres): see the doc. Secrets are at least 32 characters, and the two must differ.
# AGE_VERIFICATION_MODE="manual"
# AGE_VERIFICATION_URL="https://verify.example.org"
# What Keres signs its requests to the service with (== the service's KERES_SECRET):
# AGE_VERIFICATION_SECRET="replace-with-the-services-keres-secret"
# The key that was in use before, still accepted for the service's answers while a key is replaced:
# AGE_VERIFICATION_SECRET_PREVIOUS=""
# What the service signs its events with (== the service's EVENTS_SECRET), another key than the one above:
# AGE_VERIFICATION_EVENTS_SECRET="replace-with-the-services-events-secret"
# AGE_VERIFICATION_EVENTS_SECRET_PREVIOUS=""
# How long a call to the service may take, in milliseconds (1000 to 60000; default 10000):
# AGE_VERIFICATION_TIMEOUT_MS="10000"
# Allows the service, or a page it sends the person to, at a plain http address that is not this machine. Trusted networks only:
# AGE_VERIFICATION_ALLOW_INSECURE="false"
# Days a pending account has to be verified before it is deleted completely (1 to 365; default 30):
# AGE_VERIFICATION_PENDING_DAYS="30"
# Sendings allowed after refusals or expiries, per account (1 to 10; default 3; a refusal for `underage` has none):
# AGE_VERIFICATION_MAX_ATTEMPTS="3"

# Erase the contact messages visitors send through the site's contact channel after this many days (default 90).
# CONTACT_MESSAGE_RETENTION_DAYS="90"

# Keep the access records (when somebody signed in, signed up, recovered an account or renewed a session, and from
# which address) this many days: 1 to 730, default 183 (six months, what Marco Civil da Internet art. 15 asks of an
# application provider). They are kept under secrecy and dropped once a day after that.
# ACCESS_RECORD_RETENTION_DAYS="183"

# Erasure ledger: an append-only file of account ids and dates (no names, no content) kept OUTSIDE every backup, so
# that restoring a dump re-deletes the accounts erased after it (applied at every start). Unset = no ledger (the
# Docker compose sets it on its own volume). It keeps its lines ERASURE_LEDGER_RETENTION_DAYS (94 to 730, default 100:
# longer than the oldest backup, 93 days).
# ERASURE_LEDGER_PATH="./erasure-ledger/ledger.ndjson"
# ERASURE_LEDGER_RETENTION_DAYS="100"

# Evidence holds: when a report of the type `illegal` arrives, the server keeps a copy of the reported item and of the
# data of the person responsible (Lei 15.211/2025 art. 27) for this many days: 183 to 3650, default 183 (six months,
# Marco Civil art. 15). An administrator extends one when an authority asks. Only administrators can read them.
# EVIDENCE_HOLD_DAYS="183"

# Sync history squash: an entity's updates older than SYNC_SQUASH_AGE_DAYS (default 7) collapse into one, except its
# newest SYNC_SQUASH_KEEP_RECENT (default 20). The heavy types (scenes, sketches, boards, location maps, songs) use
# the stricter pair: older than SYNC_SQUASH_HEAVY_AGE_HOURS (default 48), newest SYNC_SQUASH_HEAVY_KEEP_RECENT (default 3).
# A device that stays offline longer than the age may see an edit conflict it would not otherwise have had.
# SYNC_SQUASH_AGE_DAYS="7"
# SYNC_SQUASH_KEEP_RECENT="20"
# SYNC_SQUASH_HEAVY_AGE_HOURS="48"
# SYNC_SQUASH_HEAVY_KEEP_RECENT="3"

# Erase the activity record (the admin's trail of what was done) after this many days, default 365. It holds no
# addresses: those are in the access records above.
# AUDIT_RETENTION_DAYS="365"

# Behind a reverse proxy (nginx, Caddy, a load balancer) the proxy MUST set the X-Forwarded-For header, appending the
# address it received the request from (nginx: `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`). Without
# it every access record names the proxy's own address. The server reads the header only when the connection comes
# from a private address (the proxy), and takes the rightmost public address in it: the first entries are written by
# the client and are ignored.

# Official Docker deploy only (docker-compose.deploy.yml): keep nightly Postgres dumps this many days
# (default 30). The rotation is what lets already-erased personal data age out of backups; longer than
# 90 days needs a written justification.
# BACKUP_RETENTION_DAYS="30"
# The first dump of each calendar month is also kept; the newest this many of those (0 to 3, default 3).
# A monthly copy older than 93 days is removed whatever the dumps since did. 0 keeps no monthly copies.
# BACKUP_MONTHLY_KEEP="3"

# Optional local administrator
# ROOT_ADMIN_USERNAME="root"
# ROOT_ADMIN_PASSWORD="replace-with-a-secure-password"

# Gallery media storage: the default is a persistent local directory.
# Do not change driver, local path, or S3 destination while this database has media. Use an
# explicit migration, or start with an empty database and empty storage.
MEDIA_STORAGE_DRIVER="local"
MEDIA_STORAGE_PATH="./media-storage"
MEDIA_MAX_BYTES="52428800"

# S3-compatible alternative (AWS S3, SeaweedFS, Ceph RGW, etc.). Uncomment this block only
# for a new/migrated database. For SeaweedFS on localhost, use the example values below.
# MEDIA_STORAGE_DRIVER="s3"
# MEDIA_S3_ENDPOINT="http://localhost:8333"
# MEDIA_S3_REGION="us-east-1"
# MEDIA_S3_BUCKET="my-bucket"
# MEDIA_S3_ACCESS_KEY_ID="admin"
# MEDIA_S3_SECRET_ACCESS_KEY="replace-with-a-secret"
# MEDIA_S3_PREFIX="keres"
# MEDIA_S3_FORCE_PATH_STYLE="true"
