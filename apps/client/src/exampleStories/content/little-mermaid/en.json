    },
    {
      "id": "scene-9",
      "storyId": "STORYLITTLEMERMAID00000000",
      "chapterId": "chapter-1",
      "locationId": "location-4",
      "name": "A royal wedding",
      "index": 4,
      "summary": "The Prince marries a neighboring princess - who is, in truth, the girl from the temple; heartbroken, the little mermaid watches the ceremony aboard the ship, knowing what the dawn will bring.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": false,
      "isStart": false,
      "isFavorite": false,
