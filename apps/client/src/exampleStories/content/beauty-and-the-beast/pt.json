  "worldRules": [
    {
      "id": "01KYXBHD0F4BB8WS98MC1Z1Y6P",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "title": "A Promessa de Retorno",
      "description": "A Fera só se livra da maldição se for amada de livre vontade. Quando permite que Bela visite sua família, ele avisa: se ela não voltar no prazo prometido, ele morrerá de tristeza.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
