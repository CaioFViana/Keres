{
  "name": "keres-monorepo",
  "version": "1.0.0",
  "author": "",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:admin": "cd apps/admin && bun run build",
    "start:api": "cd apps/api && bun run src/index.ts",
    "docker:build": "docker compose -f apps/api/docker-compose.yml build",
    "docker:up": "docker compose -f apps/api/docker-compose.yml up -d",
    "docker:down": "docker compose -f apps/api/docker-compose.yml down",
    "desktop:start": "cd apps/desktop && bun run start",
    "desktop:package": "cd apps/desktop && bun run package",
    "typecheck": "bun run --cwd packages/shared typecheck && bun run --cwd apps/client typecheck && bun run --cwd apps/api typecheck && bun run --cwd apps/admin typecheck && bun run --cwd apps/desktop typecheck",
    "lint": "bun run --cwd packages/shared lint && bun run --cwd apps/client lint && bun run --cwd apps/api lint && bun run --cwd apps/admin lint && bun run --cwd apps/desktop lint",
    "code:lines": "node scripts/count-code-lines.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "patchedDependencies": {
    "expo-sqlite@16.0.10": "patches/expo-sqlite@16.0.10.patch",
    "drizzle-orm@0.44.7": "patches/drizzle-orm@0.44.7.patch"
  }
}
