    },
    {
      "id": "01KYXBHD0FZ2NWDRHTAD2KY6YF",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "The Beast's Castle",
      "description": "An enchanted castle where Beauty's every wish is granted, except to see the Beast's true face.",
      "climate": "Grand and warm indoors, tended by unseen enchanted servants.",
      "culture": "A solitary court of one, where every comfort is offered and every meal shared only with the Beast.",
      "politics": "Ruled entirely by the Beast, though the enchantment itself answers to no one but the Fairy.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXBHD0FKEFPV8HHMXJJBST2",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "The Enchanted Garden",
      "description": "The garden and fountain where the Beast seeks comfort in his loneliness.",
      "climate": "Lush and blooming year-round, tended by the same unseen magic as the castle.",
      "culture": "A quiet retreat, the one place the Beast allows himself to be seen at his most vulnerable.",
      "politics": null,
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
