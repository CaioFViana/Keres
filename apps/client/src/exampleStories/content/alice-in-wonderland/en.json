      "name": "Alice",
      "title": null,
      "gender": "Female",
      "race": "Human",
      "subrace": null,
      "description": "A curious young girl who prefers strange adventures to ordinary boredom.",
      "personality": "Endlessly curious and quick to speak her mind, rarely frightened for long by what she sees.",
      "motivation": "Wants to make sense of Wonderland's strange rules and find her way back above ground.",
      "qualities": "Polite, logical, and remarkably composed in the face of nonsense.",
      "weaknesses": "Too curious for her own good, and easily swept along into trouble.",
      "biography": "A well-mannered girl who, bored on a riverbank, follows a talking rabbit down a hole and spends an afternoon lost in a world where nothing behaves as it should.",
      "plannedTimeline": "Wakes up on the riverbank at the story's end, leaving Wonderland behind as an extraordinary dream.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
