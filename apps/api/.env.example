# Database and authentication
#
# Two engines are supported. "postgres" (the default) talks to a Postgres server. "sqlite"
# keeps everything in a single local file, so the API runs without a database server at all -
# a good fit for a small, self-hosted instance.
#
# Do not switch driver on an instance that already has data: the two store the same schema in
# different files, and nothing is copied between them. Pick one before the first boot, or
# migrate the data yourself.
DATABASE_DRIVER="postgres"
DATABASE_URL="postgresql://user:password@localhost:5432/keres_db"

# With DATABASE_DRIVER="sqlite", DATABASE_URL is the file instead:
# DATABASE_DRIVER="sqlite"
# DATABASE_URL="file:./keres.db"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_SECRET_REFRESH="replace-with-another-random-secret-of-at-least-32-characters"
PORT="3000"
NODE_ENV="development"

# Optional local administrator
# ROOT_ADMIN_USERNAME="root"
# ROOT_ADMIN_PASSWORD="replace-with-a-secure-password"

# Gallery media storage: the default is a persistent local directory.
# Do not change driver, local path, or S3 destination while this database has media. Use an
# explicit migration, or start with an empty database and empty storage.
MEDIA_STORAGE_DRIVER="local"
MEDIA_STORAGE_PATH="./media-storage"
MEDIA_MAX_BYTES="52428800"

# S3-compatible alternative (AWS S3, SeaweedFS, Ceph RGW, etc.). Uncomment this block only
# for a new/migrated database. For SeaweedFS on localhost, use the example values below.
# MEDIA_STORAGE_DRIVER="s3"
# MEDIA_S3_ENDPOINT="http://localhost:8333"
# MEDIA_S3_REGION="us-east-1"
# MEDIA_S3_BUCKET="my-bucket"
# MEDIA_S3_ACCESS_KEY_ID="admin"
# MEDIA_S3_SECRET_ACCESS_KEY="replace-with-a-secret"
# MEDIA_S3_PREFIX="keres"
# MEDIA_S3_FORCE_PATH_STYLE="true"
