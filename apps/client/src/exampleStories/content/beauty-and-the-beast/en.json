  "characters": [
    {
      "id": "01KYXBHD0FC1Q4CNJK79XCNMVW",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "Beauty",
      "title": null,
      "gender": "Female",
      "race": "Human",
      "subrace": null,
      "description": "A merchant's youngest and kindest daughter, an avid reader with a generous heart.",
      "personality": "Gentle, thoughtful, and unfailingly kind, even to those who mistreat her.",
      "motivation": "Wants to spare her father's life, and later, to be honest with her own heart about the Beast.",
      "qualities": "Loyal, generous, and able to see past appearances to what someone truly is.",
      "weaknesses": "So devoted to others that she nearly lets the Beast die of grief rather than admit her own feelings sooner.",
      "biography": "The merchant's youngest daughter, unlike her vain sisters in temperament, who offers her own freedom to save her father from the Beast's wrath.",
      "plannedTimeline": "Returns to the castle in time, confesses her love, and breaks the curse - marrying the prince the Beast once was.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
