    },
    {
      "id": "01KYXBHD0FE9MY6A6A9B1GT176",
      "storyId": "01KYXBHD0FH380VGZSZQMXQEWM",
      "name": "A Fera",
      "title": "Príncipe amaldiçoado",
      "gender": "Masculino",
      "race": "Humano",
      "subrace": "Fera encantada",
      "description": "Um príncipe transformado em fera por uma fada, condenado a viver assim até ser amado por quem ele é de verdade.",
      "personality": "Assustador na aparência, mas cortês e melancólico por dentro, ciente do medo que causa.",
      "motivation": "Tem esperança, sem muita confiança, de que Bela possa um dia amá-lo apesar de sua forma.",
      "qualities": "Paciente, generoso e sempre gentil com Bela apesar de sua aparência monstruosa.",
      "weaknesses": "Tão convencido de que é impossível amá-lo que quase definha de tristeza quando Bela demora a voltar.",
      "biography": "Um príncipe que, ainda menino mimado e cruel, recusou abrigo a uma fada disfarçada e foi amaldiçoado a viver como fera até ser amado por quem realmente é.",
      "plannedTimeline": "Quase morre de tristeza esperando o retorno de Bela, e volta à forma humana assim que ela confessa seu amor.",
      "isFavorite": false,
      "extraNotes": null,
