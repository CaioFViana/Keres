{
  "name": "@keres/admin",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "start:showcase": "vite --config vite.showcase.config.ts",
    "build": "tsc -b && vite build && vite build --config vite.showcase.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test vitest.config.ts --ext .ts,.tsx",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@keres/shared": "workspace:*",
    "axios": "^1.13.2",
    "i18next": "^26.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.25.0",
    "ionicons": "^8.1.0",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.5.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
