    {
      "id": "01KYXBHD0M83N1C3AX7JH04JD2",
      "storyId": "01KYXBHD0ME7CZXCJDMH2Q8586",
      "chapterId": "01KYXBHD0M0HW4SKV8FKM79THS",
      "locationId": "01KYXBHD0MK3Q3KZ5X4XFDSBY8",
      "name": "The world above the waves",
      "index": 0,
      "summary": "On turning fifteen, the little mermaid rises to the surface for the first time and falls, from afar, for a prince celebrating his birthday aboard a ship.",
      "gap": null,
      "gapType": null,
      "duration": null,
      "durationType": null,
      "isFinish": false,
      "isStart": true,
      "isFavorite": false,
      "extraNotes": null,
