  "characters": [
    {
      "id": "01KYXBHD0KCR9PRYN7MHHCZF51",
      "storyId": "01KYXBHD0K6DRY76ZD6ZWKKM1K",
      "name": "Goldilocks",
      "title": null,
      "gender": "Female",
      "race": "Human",
      "subrace": null,
      "description": "A curious girl who loses her way in the forest on the way home.",
      "personality": "Curious and impulsive, quick to help herself to whatever catches her eye.",
      "motivation": "Just wants to rest and eat after getting lost - and can't resist trying everything in an empty house.",
      "qualities": "Adventurous and unbothered by walking into a stranger's home uninvited.",
      "weaknesses": "Never stops to consider that the house belongs to someone until it's far too late.",
      "biography": "A girl who wanders off the path home through the forest and stumbles on the Three Bears' empty house.",
      "plannedTimeline": "Flees out the window when the bears return, and is never seen in the forest again.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXBHD0KADEQ76V5K52QR225",
      "storyId": "01KYXBHD0K6DRY76ZD6ZWKKM1K",
      "name": "Papa Bear",
      "title": null,
      "gender": "Male",
      "race": "Bear",
      "subrace": null,
      "description": "The largest of the three bears, owner of the big chair and bed.",
      "personality": "Gruff but even-tempered, the first to notice something is wrong in the house.",
      "motivation": "Wants only to come home to a peaceful meal after a walk in the woods.",
      "qualities": "Observant - the first to notice his porridge and chair have been disturbed.",
      "weaknesses": "His big, booming voice tends to announce trouble before anyone can act on it.",
      "biography": "The father of the bear family, whose oversized bowl, chair, and bed set the pattern Goldilocks tries all three of.",
      "plannedTimeline": "Returns home to find every one of his belongings disturbed, and joins in discovering the sleeping intruder.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
      "isDeleted": false,
      "deletedAt": null
    },
    {
      "id": "01KYXBHD0KQYHTPN4R67PZQ1K3",
      "storyId": "01KYXBHD0K6DRY76ZD6ZWKKM1K",
      "name": "Mama Bear",
      "title": null,
      "gender": "Female",
      "race": "Bear",
      "subrace": null,
      "description": "The middle bear, owner of the medium chair and bed.",
      "personality": "Practical and quick to keep the household in order.",
      "motivation": "Wants the family's home and belongings kept just the way they should be.",
      "qualities": "Even-keeled - the calmest of the three when the mess is discovered.",
      "weaknesses": "Her medium-sized things are always the ones passed over as \"not quite right\" by Goldilocks.",
      "biography": "The mother of the bear family, whose porridge, chair, and bed are each tried and rejected in turn.",
      "plannedTimeline": "Discovers her own belongings disturbed just before Baby Bear finds his ruined entirely.",
      "isFavorite": false,
      "extraNotes": null,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "version": 1,
