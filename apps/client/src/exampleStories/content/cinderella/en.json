      "name": "Fairy Godmother",
      "title": null,
      "gender": "Female",
      "race": "Fairy",
      "subrace": null,
      "description": "A kindly fairy who appears in moments of greatest need.",
      "personality": "Warm, practical, and a little mischievous with her magic.",
      "motivation": "Wants Cinderella to have her one chance at the ball, however briefly.",
      "qualities": "Resourceful - able to turn a pumpkin, mice, and rags into a carriage, horses, and a gown in moments.",
      "weaknesses": "Her magic is powerful but strictly timed, and cannot be extended past midnight.",
      "biography": "A fairy who appears just as Cinderella gives up hope, transforming ordinary household things into everything she needs for one magical night.",
      "plannedTimeline": "Vanishes from the story once her magic has done its work, never seen again after the ball.",
      "isFavorite": false,
